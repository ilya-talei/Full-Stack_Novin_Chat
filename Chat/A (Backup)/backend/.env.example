APP_PORT=3001

NODE_ENV=development
# Set true to run Chat without Main-Admin / TenantCore / MinIO
LOCAL_MODE=true

LOG_LEVEL=info

DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=novin_chat
DATABASE_TEST_NAME=novin_chat_test
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/novin_chat?schema=public

MANAGER_BASE_URL=http://localhost:4000
SECRET_KEY='tenant-core-1234567890'

LOCAL_TENANT_ID=1
LOCAL_TENANT_NAME=Local Dev
LOCAL_TENANT_DOMAIN=localhost
LOCAL_TENANT_DB_NAME=novin_chat

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

CORS_ORIGIN=http://localhost:5173

SESSION_LIFETIME=18000
ACCESS_TOKEN_LIFETIME=3600

JWT_EC_PRIVATE_KEY="-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----"
JWT_EC_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
